<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Swipe-right-to-dismiss would exit the app in the middle of dragging the tracker box near the left edge.
         The Back button is the way out (and, while placing the tracker, the way on to the next control). -->
    <style name="HeatWatch" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
